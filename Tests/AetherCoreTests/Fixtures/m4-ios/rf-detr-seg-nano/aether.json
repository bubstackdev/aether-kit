  "driver": "detector-detr@1",
  "graphs": {
    "detector": {
      "compute": "gpu",
      "expectFrequentReshapes": false,
      "file": "main:rf_detr_seg_nano.aimodel",
      "function": "main",
      "inputs": {
        "image": "image"
      },
      "outputs": {
        "boxes": "dets",
        "classLogits": "labels",
        "masks": "masks"
      }
    }
  },
  "id": "rf-detr-seg-nano",
  "labels": {
    "set": "coco-91",
    "x-notes": "logit column i is COCO category id i (classIndex cocoId); the names are the kit's."
  },
  "license": "Apache-2.0",
  "postprocess": {
    "boxFormat": "cxcywh",
    "boxSpace": "normalized",
    "classIndex": "cocoId",
    "defaults": {
      "maxDetections": 100,
      "scoreThreshold": 0.5
    },
    "kind": "detrSigmoid",
    "masks": {
      "logitThreshold": 0.0
    },
    "selection": "topKPairs",
    "x-notes": "Upstream PostProcess: sigmoid over all 100 x 91 logits, the top 100 (query, class) pairs by score (stable: ties by ascending flat index query * 91 + class), each kept when score > threshold; one query can yield several classes. No NMS. Boxes are cxcywh normalized to the stretched 312 x 312 input, so to the source image; converted to xyxy and clamped to [0, 1]. The class index is the logit column, which is the COCO category id (1..90; column 0 and the ten unassigned ids never score). masks: per-query mask logits at 78 x 78 over the stretched input; upstream gathers the selected queries' planes, upsamples bilinearly (align_corners false) to the output size and keeps logit > 0."
  },
  "precision": {
    "activations": "fp32",
    "components": {
      "io": "image float32; outputs float32",
      "normalization": "float32 (in graph)"
    },
    "weights": "fp32"
  },
  "preprocess": {
    "image": {
      "channelOrder": "RGB",
      "colorSpace": "sRGB",
      "hostDType": "float32",
      "layout": "NCHW",
      "mean": [
        0.0,
        0.0,
        0.0
      ],
      "orientation": "exif",
      "resize": {
        "filter": "torchBilinear",
        "mode": "stretch",
        "size": [
          312,
          312
        ]
      },
      "scale": 0.00392156862745098,
      "std": [
        1.0,
        1.0,
        1.0
      ],
      "x-notes": "ImageNet normalization (mean 0.485/0.456/0.406, std 0.229/0.224/0.225) is in the graph: feed RGB on [0,1]. Upstream predict stretches to 312 x 312 (no aspect preservation) with torchvision bilinear resize, antialias=False, on the float image (it matches the cv2.INTER_LINEAR resize the checkpoints were trained with); torchBilinear reproduces it in float32, between the 1/255 scale and the (in-graph) normalization."
    }
  },
