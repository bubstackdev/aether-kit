  "driver": "detector-dense@1",
  "graphs": {
    "detector": {
      "compute": "gpu",
      "expectFrequentReshapes": false,
      "file": "main:yolox_s.aimodel",
      "function": "main",
      "inputs": {
        "image": "image"
      },
      "outputs": {
        "preds": "preds"
      }
    }
  },
  "id": "yolox-s",
  "labels": {
    "set": "coco-91",
    "x-notes": "class index c (0..79, contiguous) is COCO's c-th detection category in ascending category-id order; its COCO id is the c-th of the 80 used ids of coco-91 (1..90 without 12, 26, 29, 30, 45, 66, 68, 69, 71, 83). Names as upstream's COCO_CLASSES."
  },
  "license": "Apache-2.0",
  "postprocess": {
    "activation": "applied",
    "boxFormat": "cxcywh",
    "boxSpace": "letterboxPixels",
    "classIndex": "contiguous",
    "defaults": {
      "maxDetections": 50,
      "scoreThreshold": 0.3
    },
    "kind": "denseNms",
    "nms": {
      "iou": 0.45,
      "type": "perClass"
    },
    "x-notes": "preds [1,8400,85] float32, per anchor (80x80 stride 8, 40x40 stride 16, 20x20 stride 32, row-major): cx, cy, w, h in letterboxed input pixels (decoded in the graph), objectness, 80 class probabilities (sigmoid in the graph). score = obj * max(cls), class = argmax(cls); keep score >= threshold; greedy NMS per class suppressing IoU > 0.45 (xyxy); then the top maxDetections by score (upstream yolox.utils.postprocess). Map back to the source image by dividing by the letterbox ratio r."
  },
  "precision": {
    "activations": "fp32",
    "components": {
      "io": "image float32; preds float32"
    },
    "weights": "fp32"
  },
  "preprocess": {
    "image": {
      "channelOrder": "BGR",
      "colorSpace": "deviceRGB",
      "hostDType": "float32",
      "layout": "NCHW",
      "mean": [
        0.0,
        0.0,
        0.0
      ],
      "orientation": "exif",
      "resize": {
        "anchor": "topLeft",
        "filter": "pillowBilinear",
        "mode": "letterbox",
        "padValue": 114,
        "size": [
          640,
          640
        ]
      },
      "scale": 1.0,
      "std": [
        1.0,
        1.0,
        1.0
      ],
      "x-notes": "Upstream preproc (yolox/data/data_augment.py): r = min(640 / h, 640 / w), resize to (int(w r), int(h r)) (cv2 INTER_LINEAR), paste top-left on a 640 x 640 canvas filled with 114, BGR (OpenCV's decode order, no colour management), 0..255 with no scaling or normalization (the 0.1.1rc0 non-legacy weights). The references (reference_yolox.py) resize with Pillow BILINEAR in that geometry, which pillowBilinear and the kit's letterbox reproduce exactly. The graph input is float32."
    }
  },
