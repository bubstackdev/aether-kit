#!/usr/bin/env python3
"""Run a command while holding the cross-process GPU lease Aether-Kit, Atelier and the lab wrappers share.

    scripts/gpu-lease [--timeout S] [--quiet] [--directory DIR] -- <command> [args...]

Waits for the lease (default `/tmp/atelier-gpu.lock`), runs the command with `AETHER_GPU_LEASE_HOLDER` set to this
process's pid, so kit processes inside it (gates, tools) inherit the lease instead of waiting on it, and releases the
lease when the command ends. Wrap any GPU work that runs outside the Swift kit, for example a Forge check:

    scripts/gpu-lease -- uv run --project Forge python Forge/yolox/check_yolox.py ...

The protocol is `SharedGPULease` (Sources/AetherHost/GPU/SharedGPULease.swift), step for step: acquire by `mkdir`;
write the pid to `pid.tmp.<pid>` and rename it to `pid`; reclaim a lease whose pid names a dead process (ESRCH),
serialized on this user's single-link, mode-0600 `<name>.reclaim` flock file, by moving it aside, deleting the moved
copy only if it still names the same dead pid and otherwise restoring it with an exclusive rename; never reclaim a
lease without a readable pid; release by moving the lease aside, only while it names this process, then deleting it.

If this process already inherits a hand-off (`AETHER_GPU_LEASE_HOLDER` names a live ancestor that holds the lease),
the command just runs (exec) under that lease.

  --timeout S     give up after S seconds (0: one attempt); default: wait indefinitely
  --quiet         don't report a busy holder on stderr (reported when first seen, when it changes, and every 60 s)
  --directory DIR use DIR as the lease directory (tests use a private one; never needed otherwise)

Exit status: the command's. If the command dies of a signal, this process releases and dies of the same signal.
SIGINT, SIGTERM and SIGHUP are forwarded to the command; the lease is released once the command exits. (A SIGINT the
terminal sends to the whole foreground group already reached the command, so it is not sent twice.) A signal ignored
when this starts (nohup) stays ignored. Own failures: 64 usage, 71 lease directory unusable, 75 timed out,
126/127 command not executable / not found; a signal while still waiting exits 128+signal.

Standard library only; Python 3.9+.
"""
import ctypes
import ctypes.util
import errno
import os
import re
import shutil
import signal
import stat
import subprocess
import sys
import time
import uuid

try:
    import fcntl
except ImportError:  # pragma: no cover - not POSIX
    fcntl = None

SHARED_DIRECTORY = "/tmp/atelier-gpu.lock"
HOLDER_ENV = "AETHER_GPU_LEASE_HOLDER"
POLL_INTERVAL = 0.2
BUSY_REPORT_INTERVAL = 60.0
FORWARDED = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)

EX_USAGE, EX_OSERR, EX_TEMPFAIL = 64, 71, 75


def warn(text):
    sys.stderr.write("gpu-lease: %s\n" % text)
    sys.stderr.flush()


# MARK: Protocol (SharedGPULease)

def read_holder(directory):
    """The pid the lease names, if its pid file is present and well formed (decimal, positive, 32-bit)."""
    try:
        with open(os.path.join(directory, "pid"), "rb") as handle:
            text = handle.read(64).decode("utf-8").strip()
    except (OSError, UnicodeDecodeError):
        return None
    if not re.fullmatch(r"\+?[0-9]+", text):
        return None
    pid = int(text)
    return pid if 0 < pid <= 0x7FFFFFFF else None


def is_dead(pid):
    """True only when signal 0 reports no such process; a live process of another user (EPERM) is alive."""
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return True
    except OSError:
        return False
    return False


_libc = None


def _exclusive_rename(source, destination):
    """rename(2) that fails with EEXIST instead of replacing `destination`: renamex_np(RENAME_EXCL) on Darwin,
    renameat2(RENAME_NOREPLACE) on Linux. Raises OSError."""
    global _libc
    if _libc is None:
        _libc = ctypes.CDLL(ctypes.util.find_library("c") or None, use_errno=True)
    src, dst = os.fsencode(source), os.fsencode(destination)
    if sys.platform == "darwin":
        function = _libc.renamex_np
        function.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint]
        result = function(src, dst, 0x00000004)  # RENAME_EXCL, <stdio.h>
    else:
        function = _libc.renameat2
        function.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
        result = function(-100, src, -100, dst, 1)  # AT_FDCWD, RENAME_NOREPLACE
    if result != 0:
        code = ctypes.get_errno()
        raise OSError(code, os.strerror(code), source)


def _aside(directory, reason):
    parent, name = os.path.split(os.path.normpath(directory))
    return os.path.join(parent, "%s.%s-%s" % (name, reason, str(uuid.uuid4()).upper()))


def _restore(aside, directory):
    """Puts a moved lease back without ever replacing one created since."""
    try:
        _exclusive_rename(aside, directory)
    except OSError:
        warn("could not restore a GPU lease; left %s" % aside)


def _remove_tree(path):
    try:
        shutil.rmtree(path)
        return True
    except OSError:
        return False


def create(directory):
    """Takes the lease with mkdir and names this process. False when it already exists; OSError when unusable."""
    try:
        os.mkdir(directory, 0o755)
    except FileExistsError:
        return False
    pid = os.getpid()
    temporary = os.path.join(directory, "pid.tmp.%d" % pid)
    try:
        descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644)
        try:
            data = str(pid).encode()
            if os.write(descriptor, data) != len(data):
                raise OSError(errno.EIO, "short write", temporary)
        finally:
            os.close(descriptor)
        os.rename(temporary, os.path.join(directory, "pid"))
    except OSError:
        # Never leave a pid-less lease behind: move the half-made lease aside before deleting it.
        _remove_abandoned(directory)
        raise
    return True


def _remove_abandoned(directory):
    pid = os.getpid()

    def ours(path):
        holder = read_holder(path)
        return holder is None or holder == pid

    if not ours(directory):
        return
    aside = _aside(directory, "abandoned")
    try:
        os.rename(directory, aside)
    except OSError:
        return
    if not ours(aside):
        _restore(aside, directory)
        return
    _remove_tree(aside)


def release(directory):
    """Moves the lease aside only while it names this process, then deletes the moved copy (restoring it if the
    moved copy names anyone else)."""
    pid = os.getpid()
    if read_holder(directory) != pid:
        return
    aside = _aside(directory, "released")
    try:
        os.rename(directory, aside)
    except OSError:
        return
    if read_holder(aside) != pid:
        _restore(aside, directory)
        return
    _remove_tree(aside)


def clear_stale(directory):
    """Atelier's stale reclaim, step for step. True only when it removed a lease naming a dead process."""
    if fcntl is None:
        return False
    parent, name = os.path.split(os.path.normpath(directory))
    reclaim = os.path.join(parent, name + ".reclaim")
    try:
        serial = os.open(reclaim, os.O_RDONLY | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    except OSError:
        return False
    try:
        # /tmp is shared: use only this user's single-link regular file, made private if it was created 0644.
        owner = os.fstat(serial)
        if not stat.S_ISREG(owner.st_mode) or owner.st_uid != os.getuid() or owner.st_nlink != 1:
            return False
        if owner.st_mode & 0o077:
            os.fchmod(serial, 0o600)
            if os.fstat(serial).st_mode & 0o077:
                return False
        try:
            fcntl.flock(serial, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return False  # another reclaimer is mid-reclaim: report the lease as held rather than wait
        dead = read_holder(directory)
        if dead is None or not is_dead(dead):
            return False
        aside = _aside(directory, "abandoned")
        try:
            os.rename(directory, aside)
        except OSError:
            return False
        if read_holder(aside) != dead:
            _restore(aside, directory)  # changed between the read and the move: never replace a newer lease
            return False
        return _remove_tree(aside)
    except OSError:
        return False
    finally:
        os.close(serial)


# MARK: Ancestry

def ancestors():
    """This process's parent chain (excluding launchd/init), from one `ps` listing."""
    try:
        listing = subprocess.run(["/bin/ps", "-A", "-o", "pid=,ppid="], stdout=subprocess.PIPE,
                                 stderr=subprocess.DEVNULL, check=True).stdout.decode()
    except (OSError, subprocess.CalledProcessError):
        return set()
    parents = {}
    for line in listing.split("\n"):
        fields = line.split()
        if len(fields) == 2 and fields[0].isdigit() and fields[1].isdigit():
            parents[int(fields[0])] = int(fields[1])
    chain, current = set(), os.getpid()
    for _ in range(64):
        parent = os.getppid() if current == os.getpid() else parents.get(current)
        if parent is None or parent <= 1:
            break
        chain.add(parent)
        current = parent
    return chain


def inherited_holder(directory):
    """The live ancestor that handed this process the lease it holds, if any."""
    text = os.environ.get(HOLDER_ENV, "")
    if not re.fullmatch(r"[0-9]+", text.strip()):
        return None
    handed = int(text.strip())
    if handed <= 1 or read_holder(directory) != handed or is_dead(handed) or handed not in ancestors():
        return None
    return handed


# MARK: Waiting

class Signalled(Exception):
    def __init__(self, signum):
        Exception.__init__(self, signum)
        self.signum = signum


def acquire(directory, timeout, quiet, pending, own_ancestors):
    """Waits for the lease. Returns normally once held; raises Signalled, TimeoutError or OSError."""
    start = time.monotonic()
    deadline = None if timeout is None else start + max(0.0, timeout)
    reported = None  # (busy description, monotonic time)
    while True:
        if create(directory):
            return
        if clear_stale(directory) and create(directory):
            return
        if pending:
            raise Signalled(pending[0])
        holder = read_holder(directory)
        if holder is None:
            busy = "an unidentified holder (no readable pid; if nothing uses the GPU, remove %s by hand)" % directory
        elif holder in own_ancestors():
            busy = "pid %d, an ancestor of this process that did not hand off its lease (%s)" % (holder, HOLDER_ENV)
        else:
            busy = "pid %d" % holder
        now = time.monotonic()
        if reported is None or reported[0] != busy or now - reported[1] >= BUSY_REPORT_INTERVAL:
            reported = (busy, now)
            if not quiet:
                warn("waiting for the GPU lease at %s, held by %s" % (directory, busy))
        if deadline is not None and now >= deadline:
            raise TimeoutError(busy)
        time.sleep(POLL_INTERVAL if deadline is None else min(POLL_INTERVAL, deadline - now))


# MARK: Main

def parse(argv):
    timeout, quiet, directory = None, False, SHARED_DIRECTORY
    index = 0
    while index < len(argv):
        argument = argv[index]
        if argument == "--":
            index += 1
            break
        if argument == "--quiet":
            quiet = True
        elif argument in ("--timeout", "--directory") or argument.startswith(("--timeout=", "--directory=")):
            if "=" in argument:
                argument, value = argument.split("=", 1)
            else:
                index += 1
                if index >= len(argv):
                    raise ValueError("%s needs a value" % argument)
                value = argv[index]
            if argument == "--timeout":
                try:
                    timeout = float(value)
                except ValueError:
                    raise ValueError("--timeout takes seconds, not %r" % value)
                if timeout != timeout or timeout < 0:
                    raise ValueError("--timeout takes non-negative seconds")
            else:
                directory = os.path.abspath(value)
        elif argument in ("-h", "--help"):
            sys.stdout.write(__doc__)
            sys.exit(0)
        else:
            raise ValueError("unexpected %r (put the command after --)" % argument)
        index += 1
    else:
        raise ValueError("missing -- before the command")
    command = argv[index:]
    if not command:
        raise ValueError("missing the command after --")
    return timeout, quiet, directory, command


def die_like(signum):
    """Terminates this process with `signum`'s default action, as the child did."""
    try:
        signal.signal(signum, signal.SIG_DFL)
        signal.pthread_sigmask(signal.SIG_UNBLOCK, [signum])
        os.kill(os.getpid(), signum)
        time.sleep(1)
    except OSError:
        pass
    os._exit(128 + signum)


def terminal_already_signalled():
    """Whether a terminal SIGINT went to the whole foreground group, child included."""
    for stream in (sys.stdin, sys.stderr, sys.stdout):
        try:
            if stream is not None and os.isatty(stream.fileno()):
                return os.tcgetpgrp(stream.fileno()) == os.getpgrp()
        except (OSError, ValueError):
            continue
    return False


def main(argv):
    try:
        timeout, quiet, directory, command = parse(argv)
    except ValueError as error:
        warn(str(error))
        sys.stderr.write("usage: scripts/gpu-lease [--timeout S] [--quiet] [--directory DIR] -- <command> [args...]\n")
        return EX_USAGE

    if inherited_holder(directory) is not None:
        try:
            os.execvp(command[0], command)
        except OSError as error:
            warn("%s: %s" % (command[0], error.strerror))
            return 127 if error.errno == errno.ENOENT else 126

    # Handle the forwarded signals from before the mkdir, so no signal can leave the lease behind. A signal that is
    # ignored now (nohup) stays ignored, for this process and the command.
    pending, child = [], [None]

    def on_signal(signum, _frame):
        process = child[0]
        if process is None:
            pending.append(signum)
            return
        if signum == signal.SIGINT and terminal_already_signalled():
            return
        try:
            process.send_signal(signum)
        except OSError:
            pass

    for signum in FORWARDED:
        if signal.getsignal(signum) != signal.SIG_IGN:
            signal.signal(signum, on_signal)

    cache = []

    def own_ancestors():
        if not cache:
            cache.append(ancestors())
        return cache[0]

    held = False
    try:
        try:
            acquire(directory, timeout, quiet, pending, own_ancestors)
            held = True
        except Signalled as signalled:
            return 128 + signalled.signum
        except TimeoutError as busy:
            warn("timed out after %gs waiting for the GPU lease at %s, held by %s" % (timeout, directory, busy))
            return EX_TEMPFAIL
        except OSError as error:
            warn("cannot use the GPU lease at %s: %s" % (directory, error.strerror or error))
            return EX_OSERR
        if pending:
            return 128 + pending[0]

        environment = dict(os.environ)
        environment[HOLDER_ENV] = str(os.getpid())
        try:
            child[0] = subprocess.Popen(command, env=environment)
        except OSError as error:
            warn("%s: %s" % (command[0], error.strerror))
            return 127 if error.errno == errno.ENOENT else 126
        if pending:  # arrived between acquire and Popen
            on_signal(pending[0], None)
        while True:
            try:
                status = child[0].wait()
                break
            except InterruptedError:
                continue
    finally:
        if held:
            release(directory)
    if status < 0:
        die_like(-status)
    return status


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
