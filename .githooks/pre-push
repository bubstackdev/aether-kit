#!/usr/bin/env bash
# Runs the hermetic CI before every push. Enable once per clone: git config core.hooksPath .githooks
# Skip in an emergency with: git push --no-verify
# A push that only deletes remote refs (every local sha is zeros) pushes no code, so it skips the CI.
set -euo pipefail
code=false
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" =~ ^0+$ ]] || code=true
done
[[ "$code" == true ]] || { echo "pre-push: deletions only; skipping scripts/ci.sh"; exit 0; }
top="$(git rev-parse --show-toplevel)"
# Git exports GIT_DIR (and friends) to hooks. SwiftPM's own git checkouts inherit them and then read this repo's
# objects instead of the dependency's, so a fresh worktree fails to resolve packages. Clear them.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR
cd "$top"
exec "$top/scripts/ci.sh"
